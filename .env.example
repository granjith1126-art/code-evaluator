# Application Environment
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex

# Database Configuration
# Default is SQLite for instant zero-dependency local development and testing.
# For production PostgreSQL, use: postgresql+psycopg://user:password@localhost:5432/code_evaluator
DATABASE_URL=sqlite:///./app.db

# AI Provider Configuration
# Auto-discovered keys from other projects can be placed here in local .env (never commit .env!)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEFAULT_AI_PROVIDER=openai
AI_TIMEOUT_SECONDS=45
MAX_AI_RETRIES=2

# Execution Sandbox Configuration
# Sandbox options: 'docker' (uses isolated container) or 'subprocess' (local restricted subprocess)
SANDBOX_MODE=auto
SANDBOX_TIMEOUT_SECONDS=5
SANDBOX_MAX_MEMORY_MB=128
SANDBOX_MAX_OUTPUT_BYTES=65536
DOCKER_IMAGE_NAME=code-evaluator-sandbox:latest

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
